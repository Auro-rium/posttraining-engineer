# Keep developer state, test inputs, and local data out of every backend image
# build context. The Dockerfiles copy only app/, prompts/, scripts/, workers/,
# and the dependency manifests needed by their respective runtime.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
tests/
test_implementation.py
test_posttraining.py
docs/
training/
.env*
