project_id      = "replace-with-project-id"
region          = "us-central1"
container_image = "us-central1-docker.pkg.dev/replace-with-project-id/demo/backend:git-sha"
training_container_image = "us-central1-docker.pkg.dev/replace-with-project-id/demo/trainer:git-sha"
objective_execution_url  = "https://replace-with-objective-evidence-worker-url"
rag_corpus_uri            = "gs://replace-with-readable-bucket/rag/corpus.json"
rag_corpus_sha256         = ""
compute_budget_minutes    = 55
a2a_timeout_seconds       = 3300

# The coordinator receives team URIs automatically in one apply. Optionally copy
# the output URLs here in a second pass only to publish exact self URLs in the
# teams' A2A Agent Cards.
research_service_url  = ""
execution_service_url = ""

# Explicitly opt in only for a public judge-facing environment.
allow_unauthenticated = false
