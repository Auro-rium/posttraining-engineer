# Runtime defaults. Copy to .env; never commit credentials or approval secrets.
# APP_MODE=local is the credential-free explanation/demo path. Set APP_MODE=aws
# only after every LIVE configuration below is populated and live_preflight.py
# reports READY. A blocked preflight must never be treated as a successful run.
APP_MODE=local
SERVICE_ROLE=coordinator
TARGET_MODEL=google/functiongemma-270m-it
STRANDS_MODEL=nvidia.nemotron-super-3-120b
AWS_REGION=us-east-1
MAX_EXPERIMENTS=5
MAX_COST_USD=25
MAX_TRAINING_TIME_MIN=120
OBJECTIVE_SUITE=AgentGym/AgentEval
OBJECTIVE_SUITE_VERSION=agent-eval-v1
TELEMETRY_ENABLED=true
TELEMETRY_EXPORTER=logging
TELEMETRY_OTLP_ENDPOINT=

# Live AWS integrations. Required when APP_MODE=aws or when using the guarded
# scripts/live_* commands. These refer to existing resources; the controller
# does not create or delete persistent infrastructure.
S3_ARTIFACT_BUCKET=
S3_ARTIFACT_PREFIX=post-training
# Required for the isolated SERVICE_ROLE=objective HTTP API.
OBJECTIVE_AUTH_TOKEN=
# Objective /v1/benchmark is blocked unless this is a complete local snapshot
# validated against this immutable HF commit and per-file content digest.
OBJECTIVE_MODEL_CHECKPOINT_DIR=
OBJECTIVE_MODEL_REVISION=
OBJECTIVE_MODEL_SHA256=
DYNAMODB_TABLE_NAME=
SAGEMAKER_TRAINING_ROLE_ARN=
SAGEMAKER_TRAINING_IMAGE_URI=
SAGEMAKER_EVALUATION_IMAGE_URI=
OBJECTIVE_WORKER_URL=
# Bearer credential used by the coordinator when calling the objective worker.
OBJECTIVE_WORKER_AUTH_TOKEN=
OBJECTIVE_WORKER_TIMEOUT_SECONDS=600
HF_REPO_ID=
HF_REVISION=
# Optional legacy synchronous-controller input only. Autonomous live runs
# generate and verify one SFT dataset per experiment instead.
TRAINING_INPUT_S3_URI=
# Immutable static sealed-task bundle; required for held-out evaluation.
EVALUATION_INPUT_S3_URI=

# The checkpoint must already be staged in versioned S3 and its lowercase
# SHA-256 must match object metadata. A Hugging Face revision alone is not a
# usable live checkpoint for the guarded controller.
CHECKPOINT_S3_URI=
CHECKPOINT_SHA256=

# SageMaker GPU admission and bounded run controls.
POSTTRAINING_SEED=7
SAGEMAKER_INSTANCE_TYPE=ml.g5.xlarge
GPU_INSTANCE_ALLOWLIST=ml.g5.xlarge
SAGEMAKER_GPU_QUOTA_CODE=
MINIMUM_GPU_QUOTA=1
SAGEMAKER_INSTANCE_COUNT=1
SAGEMAKER_VOLUME_SIZE_GB=30
LIVE_APPROVAL_SECRET_ENV=LIVE_APPROVAL_SECRET
LIVE_APPROVAL_TTL_SECONDS=86400
LIVE_APPROVAL_SECRET=

# Optional integrations/overrides.
AGENTCORE_RUNTIME_ARN=

# Bedrock authentication note: normal AWS IAM/SigV4 credentials should leave
# AWS_BEARER_TOKEN_BEDROCK unset. If it is set, the SDK may select it instead
# of the working IAM credential chain; use it only with a valid Bedrock API key.
# AWS_BEARER_TOKEN_BEDROCK=
