# Local AWS/Strands service defaults. Copy to .env; never commit credentials.
APP_MODE=local
SERVICE_ROLE=coordinator
TARGET_MODEL=google/functiongemma-270m-it
STRANDS_MODEL=nvidia.nemotron-super-3-120b
AWS_REGION=us-east-1
MAX_EXPERIMENTS=2
MAX_COST_USD=50
MAX_TRAINING_TIME_MIN=120

# Optional live integrations. Leave unset for the credential-free explanation demo.
S3_ARTIFACT_BUCKET=
DYNAMODB_TABLE_NAME=
SAGEMAKER_TRAINING_ROLE_ARN=
SAGEMAKER_TRAINING_IMAGE_URI=
SAGEMAKER_EVALUATION_IMAGE_URI=
AGENTCORE_RUNTIME_ARN=
