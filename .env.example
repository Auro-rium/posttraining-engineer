# Local service defaults. Copy to .env; never commit real credentials.
TARGET_MODEL=google/functiongemma-270m-it
GEMINI_MODEL=gemini-3.5-flash
MAX_CANDIDATES=2
COMPUTE_BUDGET_MINUTES=55
A2A_TIMEOUT_SECONDS=3300

# Google Cloud deployment inputs (prefer Application Default Credentials locally).
GOOGLE_CLOUD_PROJECT=replace-me
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
ARTIFACT_BUCKET=replace-me
VERTEX_STAGING_BUCKET=gs://replace-me
TRAINING_CONTAINER_URI=us-central1-docker.pkg.dev/replace-me/demo/trainer:git-sha
OBJECTIVE_EXECUTION_URL=https://replace-with-objective-evidence-worker-url
RAG_CORPUS_URI=gs://replace-with-readable-bucket/rag/corpus.json
RAG_CORPUS_SHA256=
RESEARCH_A2A_URL=https://replace-with-research-service-url
EXECUTION_A2A_URL=https://replace-with-execution-service-url
HF_SECRET_ID=post-training-demo-hf-token

# Populate the secret value directly in Secret Manager. Only its resource ID is
# configuration; HF_TOKEN is intentionally omitted.
