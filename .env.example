# Copy to .env and fill in. The CLI does not read this file; load it with:
#   set -a; . ./.env; set +a
# Placeholder values below are not real keys. Never commit a filled-in .env.

# --- Backboard (LLM + memory). Required for every run except cassette replay. ---
BACKBOARD_API_KEY=your-backboard-api-key
# Backboard API base URL (default shown).
BACKBOARD_BASE_URL=https://app.backboard.io/api
# Reuse an existing Backboard assistant. Empty = create one and store its id in state/backboard.json.
BACKBOARD_ASSISTANT_ID=
# Provider name Backboard routes the primary model through.
POSTTRAIN_LLM_PROVIDER=anthropic
# Model name for the primary model.
POSTTRAIN_MODEL=claude-sonnet-4-5
# Comma-separated provider:model fallbacks, tried in order after retries are exhausted. Empty = none.
POSTTRAIN_FALLBACK_MODELS=
# Backboard memory mode for LLM calls: Auto, Readonly or off.
POSTTRAIN_MEMORY_MODE=Readonly
# Transient-error retries on the same model before falling back.
POSTTRAIN_MODEL_RETRIES=2

# --- Run recovery and state ---
# Attempts per run before a run is reported FAILED (retries resume from the last checkpoint).
POSTTRAIN_MAX_RECOVERY=3
# Root directory for checkpoints, store, telemetry, spend ledger, datasets and suites.
POSTTRAIN_STATE_DIR=state
# Optional cassette file for recording or replaying model responses. Empty = off.
POSTTRAIN_CASSETTE=
# auto (replay hits, record misses), record (always live), or replay (offline, fails on a miss).
POSTTRAIN_CASSETTE_MODE=auto

# --- Subagent concurrency ---
# Maximum subagents the coordinator runs at once. Extra task calls queue, they are not dropped. Values below 1 are read as 1.
POSTTRAIN_MAX_PARALLEL=2

# --- Nebius Token Factory (fine-tuning + evaluation). Empty key = labelled simulation. ---
NEBIUS_API_KEY=your-nebius-api-key
# OpenAI-compatible Nebius base URL (default shown).
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Base model to fine-tune, and the model used for the "base" checkpoint.
POSTTRAIN_BASE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# REQUIRED to launch a job: USD per 1M trained tokens. Nebius publishes no fine-tuning price;
# use the rate from your Nebius Token Factory account, billing console, or quote. Empty = launches are blocked.
POSTTRAIN_PRICE_PER_MTOK=
# Cumulative estimated spend cap across all launched jobs, in USD.
POSTTRAIN_MAX_COST_USD=25
# Where verified datasets (<name>.jsonl) are stored. Default is <POSTTRAIN_STATE_DIR>/data.
POSTTRAIN_DATA_DIR=state/data
# Directory containing train.jsonl, heldout.jsonl and regression.jsonl. Default is <POSTTRAIN_STATE_DIR>/suite.
POSTTRAIN_SUITE_DIR=state/suite
# Human approval before any training launch. Set to 0, false or no only for unattended runs you accept.
POSTTRAIN_REQUIRE_APPROVAL=1
# Seed for benchmark and evaluation requests and for Nebius jobs.
POSTTRAIN_SEED=7

# --- Optional tools ---
# Tavily key for web_search and web_extract. Empty = web tools report "unavailable".
TAVILY_API_KEY=your-tavily-api-key
# Hugging Face token for Hub lookups (authenticated requests and gated repos). Empty = anonymous.
HF_TOKEN=your-huggingface-token
